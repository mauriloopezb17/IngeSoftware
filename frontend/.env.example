# Variables del frontend. Copiar a frontend/.env
# Todo lo que empieza con VITE_ queda visible en el navegador: no poner secretos.

# URL base de la API. En desarrollo, Vite reenvía /api a http://localhost:3000.
VITE_API_URL=/api

# true: simula la API en el navegador con MSW (no requiere backend).
VITE_USAR_MOCKS=false
