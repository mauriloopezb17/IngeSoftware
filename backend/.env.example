# Variables de la API. Copiar a backend/.env y completar los valores marcados.
# La API las valida al arrancar (src/config/entorno.js) y no inicia si falta una obligatoria.
# Obligatorias: DATABASE_URL, REDIS_URL y JWT_SECRET. Las demás tienen un valor por defecto.
# CORS_ORIGEN acepta varios orígenes separados por comas.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Origen del frontend permitido por CORS (servidor de desarrollo de Vite).
CORS_ORIGEN=http://localhost:5173

# Proxies de confianza para leer la IP real del cliente (X-Forwarded-For).
# false (por defecto): sin proxy, la API recibe la conexión directa.
# Un número: cantidad de proxies delante de la API (ej. 1 detrás de un solo Nginx o balanceador).
# Una lista separada por comas de IPs, subredes CIDR o loopback, linklocal, uniquelocal
#   (ej. 10.0.0.0/8,loopback). No se acepta true: permitiría que el cliente falsee su IP.
TRUST_PROXY=false

# Base de datos y caché: coinciden con los valores por defecto de docker-compose.
DATABASE_URL=postgres://parroquia:parroquia_dev@localhost:5432/db_portal_cms
REDIS_URL=redis://localhost:6379
# Caché de las lecturas públicas en Redis (true por defecto). false la apaga: todo se lee de PostgreSQL.
# CACHE_HABILITADA=true

# Sesión del panel CMS (JWT en cookie httpOnly).
# Generar un secreto propio de al menos 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA_EN=8h

# Almacenamiento de archivos: Oracle Cloud Object Storage (compatible con S3).
# Opcionales: sin ellas la API funciona, pero la subida y el borrado de multimedia responden 503.
# Si se define una OCI_S3_*, hay que definirlas todas; para subir archivos también hace falta CDN_PUBLIC_URL.
OCI_S3_ENDPOINT=
OCI_S3_REGION=
OCI_S3_BUCKET_NAME=
OCI_S3_ACCESS_KEY_ID=
OCI_S3_SECRET_ACCESS_KEY=
# URL pública base desde la que el portal sirve las imágenes (bucket público). La API le agrega
# "/<clave del objeto>". Con la URL nativa de OCI, o con un dominio propio que reenvía a ella,
# debe terminar en /n/<namespace>/b/<bucket>/o (sin barra final); si no, OCI responde 404.
# Ejemplo: https://objectstorage.<region>.oraclecloud.com/n/<namespace>/b/<bucket>/o
CDN_PUBLIC_URL=
